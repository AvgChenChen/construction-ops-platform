# PostgreSQL connection for local development.
# These are local-only development credentials, matching docker-compose.yml. Never reuse them anywhere else.
DATABASE_URL="postgresql://ops_app:ops_local_dev@localhost:5432/construction_ops_dev?schema=public"

# Separate database used by the integration tests (it is wiped between test files).
TEST_DATABASE_URL="postgresql://ops_app:ops_local_dev@localhost:5432/construction_ops_test?schema=public"

# Time zone used to decide what "today" means for blockers and schedules.
APP_TIMEZONE="America/Toronto"

# Password given to the fictional demo users created by `npm run db:seed`.
SEED_DEMO_PASSWORD="demo-password-2026"
