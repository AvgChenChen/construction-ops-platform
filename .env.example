DATABASE_URL=postgresql://recruiting:local-development-only@127.0.0.1:54329/recruiting
TEST_DATABASE_URL=postgresql://recruiting:local-development-only@127.0.0.1:54329/recruiting_test
# Generate with: openssl rand -hex 32. Required for local login.
DASHBOARD_PASSWORD=
APP_ORIGIN=http://127.0.0.1:3000

# Local development uses the loopback password gate.
DEPLOYMENT_ENV=local
AUTH_MODE=local

# Production OIDC. Google is a supported example.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_SUBJECTS=

# Protected monitoring and encrypted backup operations.
MONITORING_TOKEN=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=.local/backups

# Optional PostgreSQL client paths when pg_dump and pg_restore are not on PATH.
# PG_DUMP_BIN=/opt/homebrew/opt/libpq/bin/pg_dump
# PG_RESTORE_BIN=/opt/homebrew/opt/libpq/bin/pg_restore
