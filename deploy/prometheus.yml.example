global:
  scrape_interval: 30s
rule_files:
  - /etc/prometheus/mills-alerts.yml
scrape_configs:
  - job_name: mills
    scheme: https
    metrics_path: /api/metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/mills-monitoring-token
    static_configs:
      - targets: [mills.example.com]
# Configure your existing Alertmanager and notification receiver separately.
