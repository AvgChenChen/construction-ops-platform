DEPLOYMENT_ENV=production
AUTH_MODE=oidc
APP_ORIGIN=https://mills.example.com
# Google example. Configure a Web application and this exact redirect:
# https://mills.example.com/api/auth/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated immutable sub IDs, not email addresses or domains.
OIDC_ALLOWED_SUBJECTS=
# Use a restricted runtime role and your provider's verified TLS settings.
DATABASE_URL=postgresql://runtime:REPLACE@database.example.com:5432/mills?sslmode=verify-full
# Separate random 32-byte hex values. Keep outside the image and source control.
MONITORING_TOKEN=
BACKUP_ENCRYPTION_KEY=
