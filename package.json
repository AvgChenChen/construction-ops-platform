{
  "name": "mills",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test": "vitest run",
    "worker": "tsx scripts/worker.ts",
    "test:e2e": "playwright test",
    "ops:preflight": "tsx scripts/preflight.ts",
    "backup:create": "tsx scripts/backup.ts",
    "backup:restore": "tsx scripts/restore.ts",
    "start:container": "tsx scripts/preflight.ts --production && next start --hostname 0.0.0.0",
    "backup:loop": "tsx scripts/backup-loop.ts",
    "ops:revoke-sessions": "tsx scripts/revoke-sessions.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openid-client": "6.8.8",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "4.23.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
