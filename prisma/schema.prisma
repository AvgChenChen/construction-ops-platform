// Construction Ops Platform data model.
//
// Tenant isolation is enforced twice:
//  1. The service layer scopes every query by organizationId.
//  2. Child rows reference their parents through composite foreign keys
//     (parentId, organizationId), so the database itself rejects a row that
//     points at another organization's project, task, or subcontractor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum Trade {
  GENERAL
  DEMOLITION
  CONCRETE
  FRAMING
  ROOFING
  PLUMBING
  ELECTRICAL
  HVAC
  INSULATION
  DRYWALL
  PAINTING
  FLOORING
  FINISH_CARPENTRY
  OTHER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum FollowUpStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users                 User[]
  projects              Project[]
  subcontractors        Subcontractor[]
  projectSubcontractors ProjectSubcontractor[]
  tasks                 Task[]
  taskDependencies      TaskDependency[]
  progressUpdates       ProgressUpdate[]
  issues                Issue[]
  followUps             FollowUp[]
  activity              ActivityLog[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  sessions          Session[]
  progressUpdates   ProgressUpdate[]
  issuesCreated     Issue[]          @relation("IssueCreatedBy")
  followUpsCreated  FollowUp[]       @relation("FollowUpCreatedBy")
  followUpsReviewed FollowUp[]       @relation("FollowUpReviewedBy")
  activity          ActivityLog[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie token. The raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  clientName     String?
  address        String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  startDate      DateTime      @db.Date
  targetEndDate  DateTime?     @db.Date
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks          Task[]
  subcontractors ProjectSubcontractor[]
  issues         Issue[]
  followUps      FollowUp[]
  activity       ActivityLog[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model Subcontractor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName    String
  trade          Trade
  contactName    String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())

  projects  ProjectSubcontractor[]
  tasks     Task[]
  followUps FollowUp[]

  @@unique([id, organizationId])
  @@unique([organizationId, companyName])
}

model ProjectSubcontractor {
  organizationId  String
  projectId       String
  subcontractorId String
  addedAt         DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  subcontractor   Subcontractor @relation(fields: [subcontractorId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([projectId, subcontractorId])
  @@index([organizationId])
}

model Task {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name            String
  trade           Trade
  location        String?
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  status          TaskStatus     @default(NOT_STARTED)
  percentComplete Int            @default(0)
  plannedStart    DateTime       @db.Date
  // Duration in working days (Monday to Friday). plannedEnd is derived from it.
  durationDays    Int
  plannedEnd      DateTime       @db.Date
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  dependencies TaskDependency[] @relation("Successor")
  dependents   TaskDependency[] @relation("Predecessor")
  updates      ProgressUpdate[]
  issues       Issue[]
  followUps    FollowUp[]

  @@unique([id, organizationId])
  @@index([projectId])
}

// "taskId cannot start until dependsOnId is complete" (finish-to-start).
model TaskDependency {
  organizationId String
  taskId         String
  dependsOnId    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation("Successor", fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  dependsOn      Task         @relation("Predecessor", fields: [dependsOnId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model ProgressUpdate {
  id              String       @id @default(cuid())
  organizationId  String
  taskId          String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status          TaskStatus
  percentComplete Int
  note            String
  // "manual" today. "ai_agent" is reserved for updates proposed by field-update-ai-agent.
  source          String       @default("manual")
  createdAt       DateTime     @default(now())

  @@index([taskId, createdAt])
}

model Issue {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title          String
  details        String?
  severity       IssueSeverity @default(MEDIUM)
  // A blocking issue stops its linked task from progressing.
  isBlocker      Boolean       @default(false)
  status         IssueStatus   @default(OPEN)
  createdById    String?
  createdBy      User?         @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, status])
  @@index([projectId])
}

model FollowUp {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  message         String
  dueDate         DateTime?      @db.Date
  status          FollowUpStatus @default(PENDING_APPROVAL)
  createdById     String?
  createdBy       User?          @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?          @relation("FollowUpReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime       @default(now())

  @@index([organizationId, status])
  @@index([projectId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  summary        String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}
